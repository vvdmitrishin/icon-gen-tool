# AI Collection Studio — environment template.
# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real secrets.
# Keys live server-side only; the React bundle never sees them (spec §19.1).

# --- Defaults ---
DEFAULT_IMAGE_PROVIDER=gemini
DEFAULT_IMAGE_MODEL=gemini-nano-banana-2.1
DEFAULT_PLANNING_MODE=rules

# --- Google Gemini (PRIMARY, only enabled paid provider) ---
GEMINI_API_KEY=
GEMINI_API_ENABLED=true
# Send generationConfig.imageConfig.aspectRatio. Set false if the API rejects it.
GEMINI_SEND_IMAGE_CONFIG=true
GEMINI_TIMEOUT_SECONDS=120
# ESTIMATE of USD per generated image (spec §12.3 cites ~0.067 for 1K). Used for the
# local cost guard only; the real bill is whatever Google Billing says.
GEMINI_EST_COST_PER_IMAGE_USD=0.067

# --- Budget guards (best-effort local estimates, not a Google-side hard limit) ---
PAID_IMAGE_CALLS_ENABLED=true
# Max estimated spend for one job/request.
GEMINI_JOB_BUDGET_USD=0.50
# Cumulative local cap across all runs (ledger in data/ledger.jsonl). Keep below your prepaid balance.
GEMINI_TOTAL_BUDGET_USD=4.00
# Automatic retries are OFF until you deliberately raise this.
MAX_CARD_RETRIES=0
MAX_PARALLEL_GENERATIONS=1
MAX_IMAGES_PER_JOB=50

# --- Cloudflare Workers AI (verified free FALLBACK; adapter arrives in Phase 2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- OpenAI GPT Image: SPECIFIED but DISABLED. No key, no billing, no calls. ---
OPENAI_API_KEY=
OPENAI_IMAGE_ENABLED=false
OPENAI_PAID_CALLS_ENABLED=false
OPENAI_IMAGE_DEFAULT_MODEL=gpt-image-2.5-flare

# --- Mock provider (no network, no cost) for UI/pipeline testing; labelled "Mock" everywhere ---
ENABLE_MOCK_PROVIDER=true

# --- Storage ---
# Relative paths resolve against the repository root.
DATA_ROOT=./data
ARTIFACT_ROOT=./data/artifacts
MAX_UPLOAD_BYTES=10485760
MAX_REFS_PER_REQUEST=5

# --- Optional / future ---
COMFYUI_BASE_URL=
TEXT_PLANNER_PROVIDER=
